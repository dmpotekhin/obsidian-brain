#!/bin/bash
# obsidian-brain MCP server launcher
# Set BRAIN_VAULT env var before running, e.g.:
#   export BRAIN_VAULT="/path/to/your/Obsidian/Vault"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -z "${BRAIN_VAULT:-}" ]; then
  echo "Error: BRAIN_VAULT is not set. Set it to your Obsidian vault path." >&2
  exit 1
fi

export PATH="$HOME/.bun/bin:$PATH"
exec bun run "$REPO_DIR/src/cli.ts" mcp
